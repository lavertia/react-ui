{
  "name": "@lavertia/ui-shadcn",
  "version": "0.1.0-alpha.1",
  "private": true,
  "description": "Portable shadcn UI Kit adapter for Lavertia React (staging prior to standalone repository)",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@lavertia/react-ui": "github:lavertia/react-ui#main",
    "@lavertia/ui": "github:lavertia/ui#main"
  },
  "peerDependencies": {
    "@inertiajs/react": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@inertiajs/react": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0"
  }
}
